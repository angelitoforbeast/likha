APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=likha
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Ang chatbot at chatblast queue (Horizon): database ngayon; redis kapag naka-Horizon na (pabalik: database)
CHATBOT_QUEUE_CONNECTION=database
CHATBLAST_QUEUE_CONNECTION=database
# Ilang worker hanggang sa Horizon (pinakamarami)
HORIZON_CHATBOT_MAX=16
HORIZON_CHATBLAST_MAX=8

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis: walang PHP extension (phpredis kapag naka-install, mas mabilis)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Mas mahaba sa pinakamahabang job ng chatbot at chatblast (300 s)
REDIS_QUEUE_RETRY_AFTER=400
# Ang cache data sa sariling Redis instance (LRU); ang queue at mga lock ay sa REDIS_HOST/REDIS_PORT (noeviction)
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
REDIS_CACHE_PASSWORD=null

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── AI Boardroom (/boardroom) ───────────────────────────────────────────
# WALANG provider API key dito. Ang key ng bawat role ay inilalagay sa /boardroom/agents
# (naka-encrypt sa database; hindi bumabalik sa browser).
# Opsyonal na hiwalay na encryption key — gawin gamit ang: php artisan boardroom:key
# Blangko = APP_KEY ang gagamitin.
BOARDROOM_ENCRYPTION_KEY=
BOARDROOM_QUEUE=default
BOARDROOM_MAX_CALLS=16
BOARDROOM_MAX_CYCLES=3
BOARDROOM_MAX_OUTPUT_TOKENS=16000
BOARDROOM_TIMEOUT_S=240
BOARDROOM_MAX_RETRIES=2

# Read-only staff feed key (header X-STAFF-FEED-KEY); walang laman = naka-off ang feed
STAFF_FEED_KEY=
# User id ng mga automation account sa staff feed (comma-separated, hal. 12,40); is_bot=true sa kanila
STAFF_FEED_BOT_USER_IDS=

# Botcake customer sync sa schedule (kada oras + Linggo 01:00 full); true lang pagkatapos ng one-page test
BOTCAKE_SYNC_ENABLED=false
# Max na batch (10 customer bawat isa) kada incremental sync ng isang page
BOTCAKE_SYNC_MAX_BATCHES=300
# Hanggang ilang araw ng subscriber ang binabasa ng bawat Botcake sync (pinakabago muna ang listahan)
BOTCAKE_SYNC_MAX_AGE_DAYS=45
# /page-settings: ang rows ay ang mga page na may order sa huling ilang araw (ts_date), saka ang may settings
BOTCAKE_GRID_ORDER_DAYS=30
# Sync lahat: laktaw ang page na incremental lang ang kailangan at may matagumpay na sync sa huling ilang oras
BOTCAKE_SYNC_ALL_FRESH_HOURS=6
# /chatblast: hanggang ilang totoong mensahe kada page kada araw
BOTCAKE_CHATBLAST_DAILY_CAP=3000
# /chatblast: segundo bago ang susunod na mensahe sa parehong customer
BOTCAKE_CHATBLAST_CUSTOMER_GAP=20
# /chatblast "Open in Botcake": {page_id} = botcake.page_id, {psid} = customer (optional)
BOTCAKE_INBOX_URL=https://botcake.io/pages/{page_id}/live_chat
# /api/botcake/chat (JSON API block ng Botcake): ang shared key sa header X-Chat-Key; walang laman = 401 sa lahat
BOTCAKE_CHAT_KEY=
# /api/botcake/chat: ilang request kada minuto kada IP
BOTCAKE_CHAT_RATE=1200
# /api/botcake/chat: ang shared key ay tinatanggap pa (false kapag may sariling chat.key na ang lahat ng page)
BOTCAKE_CHAT_SHARED_KEY_OK=true
# /api/botcake/chat: mga IP/CIDR ng Botcake (kuwit ang hati); mode log (itinatala ang iba) o enforce (403 sa iba)
BOTCAKE_CHAT_IPS=203.171.22.6
BOTCAKE_CHAT_IP_MODE=log
# /api/botcake/chat: ilang bagong PSID kada minuto kada page ang sinusuri sa Botcake
BOTCAKE_CHAT_VERIFY_PER_MINUTE=60
# Padala sa Botcake: ilang request kada segundo kada page; true = sa botcake:send-pool (supervisor), false = naghihintay ang worker
BOTCAKE_RATE_PER_PAGE=2
BOTCAKE_ASYNC_SENDS=true
BOTCAKE_SEND_CONCURRENCY=100
# /chatbot: emergency stop. true = ang page na On at may flow ay sumasagot; false = walang padala o sheet row (skipped)
CHATBOT_REPLIES_ENABLED=true
# /chatbot AI step: true = hindi naghihintay ang worker (kailangan ang chatbot:ai-pool sa supervisor); false = naghihintay (ang dati)
CHATBOT_AI_ASYNC=true
# Ilang request sa OpenAI nang sabay sa chatbot:ai-pool
CHATBOT_AI_CONCURRENCY=50
# Ilang segundo bago walang sagot ang AI step ng chatbot (failed port)
OPENAI_TIMEOUT=60

# Kusang J&T track-sync kada oras (:20 ng 02 at 06-23 Manila); ang toggle sa /jnt/track-sync ang nananaig kapag ginamit
JNT_TRACK_SYNC_AUTO=false
