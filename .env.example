APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=likha
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Ang chatbot at chatblast queue (Horizon): database ngayon; redis kapag naka-Horizon na (pabalik: database)
CHATBOT_QUEUE_CONNECTION=database
CHATBLAST_QUEUE_CONNECTION=database
# Ilang worker hanggang sa Horizon (pinakamarami)
HORIZON_CHATBOT_MAX=40
HORIZON_CHATBLAST_MAX=8

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis: walang PHP extension (phpredis kapag naka-install, mas mabilis)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Mas mahaba sa pinakamahabang job ng chatbot at chatblast (300 s)
REDIS_QUEUE_RETRY_AFTER=400
# Blocking pop ng Redis queue (segundo); 0 = polling gaya ng dati. Laging mas mataas ang read-write timeout ng predis.
REDIS_QUEUE_BLOCK_FOR=5
REDIS_READ_WRITE_TIMEOUT=60
# Tulog kada ikot ng chatbot:ai-pool at botcake:send-pool (ms): idle at busy
CHATBOT_POOL_IDLE_MS=200
CHATBOT_POOL_BUSY_MS=5
# Forbeast Gateway (chatbot.provider = gateway kada page): walang URL = hindi mapipili ang gateway
GATEWAY_URL=
GATEWAY_KEY=
GATEWAY_WEBHOOK_SECRET=
GATEWAY_TIMEOUT=10
# Other addresses of the same gateway (same key and page token, another Meta app), chosen per page: "key=url key2=url2"
GATEWAY_URLS=
# The Meta app id of each of those addresses, same keys: "key=app_id key2=app_id2" (its echoes are the bot's own replies)
GATEWAY_APP_IDS=
# true = gateway calls over IPv4 only (to test whether the calls without an answer are IPv6 only)
GATEWAY_FORCE_IPV4=false
# Page owners and transfers between the partner sites: the site system's fbs_ key and its webhook secret in Forbeast
FORBEAST_SITE_KEY=
FORBEAST_SITE_SECRET=
# The second gateway (incepxionbot.com): the same settings as GATEWAY_* and FORBEAST_SITE_*; an empty URL = not set up
INCEPXIONBOT_URL=
INCEPXIONBOT_KEY=
INCEPXIONBOT_WEBHOOK_SECRET=
INCEPXIONBOT_TIMEOUT=10
INCEPXIONBOT_TYPING=true
INCEPXIONBOT_SITE_KEY=
INCEPXIONBOT_SITE_SECRET=
INCEPXIONBOT_APP_ID=
# Kusang lipat sa Botcake kapag pumapalya ang Forbeast (chatbot:forbeast-watch kada minuto): ang mga default
GATEWAY_SWITCH_FAILED_SENDS=5
GATEWAY_SWITCH_NO_ANSWER=3
GATEWAY_SWITCH_HEALTH_FAILS=3
GATEWAY_SWITCH_INBOUND_CHATS=1
GATEWAY_SWITCH_INBOUND_MINUTES=10
GATEWAY_SWITCH_STANDBY_MINUTES=15
GATEWAY_SWITCH_INBOUND_CUSTOMERS=3
GATEWAY_SWITCH_INBOUND_SECONDS=300
GATEWAY_SWITCH_LAG_SECONDS=60
GATEWAY_SWITCH_BACK_MINUTES=30
GATEWAY_SWITCH_BACK_GAP_MINUTES=60
GATEWAY_SWITCH_SETTLE_SECONDS=180
GATEWAY_SWITCH_HOLD_MINUTES=2
GATEWAY_SWITCH_BURST_PAGES=5
GATEWAY_SWITCH_BURST_SECONDS=60
GATEWAY_ECHO_UNANSWERED_MINUTES=5
GATEWAY_ECHO_UNANSWERED_CUSTOMERS=3
GATEWAY_ECHO_DOUBLE_SECONDS=60
# Ang banner ng mga problema: mabagal (3× ng karaniwan o 60 s, 5 sagot man lang) at walang chat (20 kada oras, 30 min)
CHATBOT_SLOW_FACTOR=3
CHATBOT_SLOW_SECONDS=60
CHATBOT_SLOW_MIN_REPLIES=5
CHATBOT_NO_CHATS_PER_HOUR=20
CHATBOT_NO_CHATS_MINUTES=30
# Ang key ng /api/chatbot/provider-events (header X-CHATBOT-EVENTS-KEY); walang laman = 401
CHATBOT_EVENTS_KEY=
# Pag-pause ng bot kada customer mula sa /chatbot/inbox (false = nakatago, unpause lang ang gumagana)
CHATBOT_INBOX_BOT_PAUSE=false
# Ang cache data sa sariling Redis instance (LRU); ang queue at mga lock ay sa REDIS_HOST/REDIS_PORT (noeviction)
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
REDIS_CACHE_PASSWORD=null

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── AI Boardroom (/boardroom) ───────────────────────────────────────────
# WALANG provider API key dito. Ang key ng bawat role ay inilalagay sa /boardroom/agents
# (naka-encrypt sa database; hindi bumabalik sa browser).
# Opsyonal na hiwalay na encryption key — gawin gamit ang: php artisan boardroom:key
# Blangko = APP_KEY ang gagamitin.
BOARDROOM_ENCRYPTION_KEY=
BOARDROOM_QUEUE=default
BOARDROOM_MAX_CALLS=16
BOARDROOM_MAX_CYCLES=3
BOARDROOM_MAX_OUTPUT_TOKENS=16000
BOARDROOM_TIMEOUT_S=240
BOARDROOM_MAX_RETRIES=2

# Read-only RTS check feed key (header X-RTS-CHECK-KEY, GET /api/owner/rts-check); walang laman = naka-off
RTS_CHECK_KEY=

# Sulatan ng analyst ng Mira RTS (header X-ANALYST-RTS-KEY, POST /api/owner/analyst-rts); walang laman = naka-off
ANALYST_RTS_KEY=

# Read-only staff feed key (header X-STAFF-FEED-KEY); walang laman = naka-off ang feed
STAFF_FEED_KEY=
# User id ng mga automation account sa staff feed (comma-separated, hal. 12,40); is_bot=true sa kanila
STAFF_FEED_BOT_USER_IDS=

# Botcake customer sync sa schedule (kada oras + Linggo 01:00 full); true lang pagkatapos ng one-page test
BOTCAKE_SYNC_ENABLED=false
# Max na batch (10 customer bawat isa) kada incremental sync ng isang page
BOTCAKE_SYNC_MAX_BATCHES=300
# Hanggang ilang araw ng subscriber ang binabasa ng bawat Botcake sync (pinakabago muna ang listahan)
BOTCAKE_SYNC_MAX_AGE_DAYS=45
# /page-settings: ang rows ay ang mga page na may order sa huling ilang araw (ts_date), saka ang may settings
BOTCAKE_GRID_ORDER_DAYS=30
# Sync lahat: laktaw ang page na incremental lang ang kailangan at may matagumpay na sync sa huling ilang oras
BOTCAKE_SYNC_ALL_FRESH_HOURS=6
# /chatblast: hanggang ilang totoong mensahe kada page kada araw
BOTCAKE_CHATBLAST_DAILY_CAP=3000
# /chatblast: segundo bago ang susunod na mensahe sa parehong customer
BOTCAKE_CHATBLAST_CUSTOMER_GAP=20
# /chatblast "Open in Botcake": {page_id} = botcake.page_id, {psid} = customer (optional)
BOTCAKE_INBOX_URL=https://botcake.io/pages/{page_id}/live_chat
# /api/botcake/chat (JSON API block ng Botcake): ang shared key sa header X-Chat-Key; walang laman = 401 sa lahat
BOTCAKE_CHAT_KEY=
# /api/botcake/chat: ilang request kada minuto kada IP
BOTCAKE_CHAT_RATE=1200
# /api/botcake/chat: ang shared key ay tinatanggap pa (false kapag may sariling chat.key na ang lahat ng page)
BOTCAKE_CHAT_SHARED_KEY_OK=true
# /api/botcake/chat: mga IP/CIDR ng Botcake (kuwit ang hati); mode log (itinatala ang iba) o enforce (403 sa iba)
BOTCAKE_CHAT_IPS=203.171.22.6
BOTCAKE_CHAT_IP_MODE=log
# /api/botcake/chat: ilang bagong PSID kada minuto kada page ang sinusuri sa Botcake
BOTCAKE_CHAT_VERIFY_PER_MINUTE=60
# Padala sa Botcake: ilang request kada segundo kada page; true = sa botcake:send-pool (supervisor), false = naghihintay ang worker
BOTCAKE_RATE_PER_PAGE=2
# Ang bahagi ng rate ng page na gamit ng chatblast habang may sagot ang bot (0.5 = kalahati)
BOTCAKE_CHATBLAST_SHARE=0.5
BOTCAKE_ASYNC_SENDS=true
BOTCAKE_SEND_CONCURRENCY=100
BOTCAKE_SEQUENCE_CONCURRENCY=100
BOTCAKE_SEND_TIMEOUT=30
# /chatbot: emergency stop. true = ang page na On at may flow ay sumasagot; false = walang padala o sheet row (skipped)
CHATBOT_REPLIES_ENABLED=true
# /chatbot AI step: true = hindi naghihintay ang worker (kailangan ang chatbot:ai-pool sa supervisor); false = naghihintay (ang dati)
CHATBOT_AI_ASYNC=true
CHATBOT_SEQUENCE_HANDOFF=true
CHATBOT_SEQUENCE_GATEWAY_PER_PAGE=30
# Ilang request sa OpenAI nang sabay sa chatbot:ai-pool
CHATBOT_AI_CONCURRENCY=100
# Ilang segundo bago walang sagot ang AI step ng chatbot (failed port)
OPENAI_TIMEOUT=60
# Model ng content check ng /chatbot/pages (item, presyo, larawan, ad video); kailangan may vision
CHATBOT_CONTENT_MODEL=gpt-4o-mini
# Model ng paste sa Edit ng isang page (field ng bawat cell); blangko = ang CHATBOT_CONTENT_MODEL
CHATBOT_PASTE_MAP_MODEL=gpt-5.2
# Order encode (spec 130): OpenAI key ng sariling encode/check ng mga order; blangko = ang OPENAI_API_KEY
ORDER_ENCODE_OPENAI_KEY=

# Kusang J&T track-sync kada oras (:20 ng 02 at 06-23 Manila); ang toggle sa /jnt/track-sync ang nananaig kapag ginamit
JNT_TRACK_SYNC_AUTO=false

# Meta Ads (Connect Facebook sa /ads_manager/report): ang Meta app (Facebook Login + Marketing API). Blangko = "Meta app not set up yet".
# Ang redirect URL na ilalagay sa app: <APP_URL>/ads_manager/meta/callback
META_ADS_APP_ID=
META_ADS_APP_SECRET=
# Facebook Login for Business: ang configuration ID sa Meta app (permission ads_read). May laman = config_id sa Connect
# sa halip na scope=ads_read; blangko = scope=ads_read gaya ng dati. Kailangan pa rin ang APP_ID at APP_SECRET.
META_ADS_CONFIG_ID=
META_ADS_GRAPH_VERSION=v25.0
# Oras (Manila, H:i) ng araw-araw na Ads data health check (ads:data-health --record). Blangko = 12:00.
META_ADS_DATA_HEALTH_AT=12:00

# Nexus (warehouse app) stock-in para sa /item (nexus:sync-stock, kada oras). Blangko ang token = hindi naka-configure:
# walang tawag, at ang stock sa /item ay ang dating PO-received. Ang URL ay may default (Nexus server).
NEXUS_API_URL=
NEXUS_API_TOKEN=
NEXUS_API_TIMEOUT=20
# Mula kailan kinukuha ng `nexus:sync-stock --history` ang stock-in bago ang item_stock_start. Blangko = 2026-01-01.
NEXUS_STOCK_HISTORY_FROM=
